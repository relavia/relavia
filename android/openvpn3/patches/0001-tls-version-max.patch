+// Relavia downstream addition (not upstream): parse the
+// tls-version-max option. Upstream deliberately leaves the
+// corresponding SSL config field unexposed ("use for testing
+// only"); Relavia exposes it because legacy SoftEther
+// OpenVPN-clone servers only capture the client certificate
+// during a classic (<= TLS 1.2) handshake — see
+// docs/真机连接失败诊断-2026-11-14.md §10 in the Relavia repo.
+inline Type parse_tls_version_max(const OptionList &opt,
+                                  const std::string &relay_prefix)
+{
+    const Option *o = opt.get_ptr(relay_prefix + "tls-version-max");
+    if (o)
+    {
+        const std::string ver = o->get_optional(1, 16);
+        if (ver == "1.0")
+            return Type::V1_0;
+        if (ver == "1.1")
+            return Type::V1_1;
+        if (ver == "1.2")
+            return Type::V1_2;
+        if (ver == "1.3")
+            return Type::V1_3;
+        throw option_error(ERR_INVALID_OPTION_CRYPTO, "tls-version-max: unrecognized TLS version");
+    }
+    return Type::UNDEF;
+}
