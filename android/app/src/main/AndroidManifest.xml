<?xml version="1.0" encoding="utf-8"?>
<!--
  Relavia Android manifest (Step 10; product UI hosting added
  per docs/android产品界面接入.md).

  Only public Android APIs are used — no root, no system
  signature permissions. The VPN facility is the stock
  android.net.VpnService, declared exactly as the platform
  requires (BIND_VPN_SERVICE + the VpnService intent filter).

  The LAUNCHER is the product UI itself: org.gioui.GioActivity
  (vendored Gio classes in this project) hosting the Go/Gio
  surface — nodes, import, sources, settings. The Step 10
  shell page is retired; what remains of the shell is
  infrastructure: RelaviaApp (bootstrap), ConsentActivity
  (the VpnService consent dialog surface for the Go bridge)
  and RelaviaVpnService.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required on API 34+ because the VPN service below runs
         as a specialUse foreground service; without this
         permission startForeground with that type throws. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".RelaviaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- The product UI (Go/Gio). Attributes mirror the
             manifest gogio generates for this same activity:
             Gio handles configuration changes itself, the
             soft-input mode keeps the view resized for the
             on-screen keyboard, and singleInstance keeps one
             product window per install. -->
        <activity
            android:name="org.gioui.GioActivity"
            android:configChanges="screenSize|screenLayout|smallestScreenSize|orientation|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.RelaviaGio"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Invisible consent surface for the Go bridge: runs
             the system VpnService consent dialog and reports
             to ShellBridgeImpl. Never a launcher. -->
        <activity
            android:name=".ConsentActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".RelaviaVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
            <!-- Mandatory justification declaration for the
                 specialUse foreground-service type (API 34+). -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN tunnel service: maintains the user-started VPN connection and its mandatory persistent notification while connected." />
        </service>
    </application>
</manifest>
